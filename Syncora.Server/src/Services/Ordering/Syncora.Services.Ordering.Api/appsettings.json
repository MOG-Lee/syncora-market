{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Users/mogpr/Desktop/Project assets/Logs/ordering-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId: {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "OrderingDb": "Server=.;Database=Syncora.Ordering;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "Syncora_Super_Secret_KeyabcABfDS$££458ffgGF554oOfDFGshj",
    "Issuer": "SyncoraIdentityAPI",
    "Audience": "SyncoraMicroservices",
    "ExpiryMinutes": 60000
  }
}
